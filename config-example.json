{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "local": {
          "name": "Local model",
          "limit": {
            "context": 8192,
            "output": 1024
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          }
        }
      }
    }
  }
}
